    "us_yield": {
      "id": 6,
      "name": "美债利差(10Y-2Y)",
      "category": "auxiliary",
      "category_label": "辅助-全球宏观",
      "unit": "bp",
      "threshold_type": "qualitative",
      "threshold_desc": "10Y-2Y利差<0即倒挂(衰退预警)；0~+25bp走平(周期后期预警)；>=+25bp健康正斜率",
      "warning_level": "warning",
      "data_source": "sina_us_treasury_daily",
      "update_freq": "daily",
      "note": "新浪财经 bond.finance.sina.com.cn 每日收盘收益率（国内可达、腾讯云直连）自动抓取；Cloudflare Worker 中继/美财政部直连作为降级。SCF 定时函数自动刷新。"
    },
    "national_team_etf": {
      "id": 10,
      "name": "国家队ETF持仓/增减持",
      "category": "auxiliary",
      "category_label": "辅助-国家队护盘",
      "unit": "万亿",
      "threshold_type": "qualitative",
      "threshold_desc": "国家队份额/持仓比例见顶回落、近三月净申赎转负(净赎回)=减/撤→预警/危险；持续持有或增持=正常（逆向托底逻辑）",
      "warning_level": "warning",
      "data_source": "fund_disclosure_top10_holders + 官方汇总交叉核对",
      "update_freq": "monthly/quarterly",
      "note": "数据底稿：各ETF基金定期报告「前十大持有人」(中央汇金投资/资管及专项资管计划/证金关联)，经 wangwang-etf.com 聚合、披露日即真实filing日；并以官方汇总(中央汇金ETF持仓市值1.28万亿@2025H1→1.53万亿@2025年末)交叉核对核心宽基ETF持仓金额求和≈1.53万亿，量级吻合。信号逻辑：国家队为A股托底力量，其减/撤=散户接力冲顶后期特征=逃顶窗口打开。因站点反爬无法自动抓取，由WorkBuddy浏览器核对或人工录入写入缓存。"
    }
