    "sentiment": {
      "id": 9,
      "name": "舆情热度/定性判断",
      "category": "auxiliary",
      "category_label": "辅助-市场情绪",
      "unit": "分",
      "threshold": 4,
      "threshold_operator": ">=",
      "threshold_desc": "AI评分1-5：全民炒股/狂热=4-5；>=4预警",
      "warning_level": "warning",
      "data_source": "ai_eval",
      "update_freq": "daily",
      "ai_eval_standard": "1分 低迷：市场讨论度低，新股民稀少，社交平台A股话题冷清，基金发行遇冷。\n2分 温和：讨论度一般，未到全民炒股，开户数平稳。\n3分 活跃：散户活跃度明显上升，新开户同比高增，自媒体A股内容热度上升，基金发行回暖。\n4分 亢奋(预警)：全民炒股特征初现——新开户暴增(同比>50%)、日光基频现、社交平台刷屏看涨、散户杠杆快速上升，但已出现\"赚指数不赚钱\"等早期裂痕。\n5分 狂热(危险)：街头巷尾谈股、新开户环比仍加速、融资余额占比快速攀升、出现\"这次不一样\"叙事、IPO/打新全民参与。\n阈值：评分>=4 触发预警。",
      "ai_eval_version": "2026-07-28",
      "note": "由AI检索中文互联网舆情自动评分，标准见ai_eval_standard"
    },
    "ipo_finance": {
      "id": 7,
      "name": "IPO/再融资规模",
      "category": "auxiliary",
      "category_label": "辅助-融资减持",
      "unit": "亿",
      "threshold_type": "qualitative",
      "threshold_desc": "大型IPO案例频发（需人工判断）",
      "warning_level": "info",
      "data_source": "public_data",
      "update_freq": "weekly"
    },
    "shareholder_reduce": {
      "id": 8,
      "name": "重要股东减持",
      "category": "auxiliary",
      "category_label": "辅助-融资减持",
      "unit": "亿",
      "threshold": 1000,
      "threshold_operator": ">",
      "threshold_desc": "单月减持金额",
      "warning_level": "warning",
